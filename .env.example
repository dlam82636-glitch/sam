# ==============================================================================
# PRICERA Environment Configuration (.env.example)
# All sensitive variables below are SERVER-SIDE ONLY and never exposed to the client.
# ==============================================================================

# [REQUIRED for AI Understanding] Google Gemini API Key
# Used server-side by @google/genai (model: gemini-3.1-flash-lite with gemini-3.8-flash fallback)
# Required: YES (core query understanding stage)
GEMINI_API_KEY=

# [OPTIONAL for Web Research] External HTTP Web Search Provider Keys
# Used server-side to retrieve real commercial listings & prices.
# If omitted, PRICERA gracefully reports live research is unconfigured without fake data.
# Optional: YES
SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# [OPTIONAL for Database Persistence] PostgreSQL Connection String
# e.g., postgresql://username:password@localhost:5432/pricera_db
# If omitted, PRICERA uses an in-memory relational repository driver with identical schema semantics.
# Optional: YES
DATABASE_URL=

# [OPTIONAL] Server Network Port
# Defaults to 3000 if not specified
# Optional: YES
PORT=3000

